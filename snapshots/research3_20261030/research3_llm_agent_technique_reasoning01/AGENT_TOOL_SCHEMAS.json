{
  "scope": "one execution-step, runtime candidate/source/evidence validation required",
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "search_events",
        "parameters": {
          "type": "object",
          "properties": {
            "source_type": {
              "type": "string"
            },
            "keywords": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "minItems": 1,
              "maxItems": 32
            },
            "time_range": {
              "type": "null",
              "description": "Non-null time ranges are explicitly unsupported."
            },
            "max_results": {
              "type": "integer",
              "minimum": 1,
              "maximum": 40
            }
          },
          "required": [
            "source_type",
            "keywords"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "get_event_context",
        "parameters": {
          "type": "object",
          "properties": {
            "event_id": {
              "type": "string"
            },
            "before": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "after": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            }
          },
          "required": [
            "event_id"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "search_related_entities",
        "parameters": {
          "type": "object",
          "properties": {
            "entity_type": {
              "type": "string",
              "enum": [
                "ip",
                "domain",
                "process",
                "path",
                "user",
                "literal"
              ]
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "max_results": {
              "type": "integer",
              "minimum": 1,
              "maximum": 40
            }
          },
          "required": [
            "entity_type",
            "value"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "retrieve_attack_technique",
        "parameters": {
          "type": "object",
          "properties": {
            "technique_id": {
              "type": "string"
            }
          },
          "required": [
            "technique_id"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "submit_technique_ranking",
        "parameters": {
          "type": "object",
          "properties": {
            "ranking": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 10,
              "maxItems": 10,
              "uniqueItems": true
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "ranking",
            "evidence_ids"
          ],
          "additionalProperties": false
        }
      }
    }
  ]
}